# Copia a .env (nunca lo subas a git). Clave en intervals.icu > Settings > Developer Settings
INTERVALS_ATHLETE_ID=i000000
INTERVALS_API_KEY=

# running, cycling, swimming_pool, swimming_open (el primero es el principal si no hay objetivo)
ACTIVE_SPORTS=running,cycling
# gym | bodyweight | none
STRENGTH=gym
# Días sin entrenamiento: MON,TUE,WED,THU,FRI,SAT,SUN
REST_DAYS=MON
# Inicio de la preparación (YYYY-MM-DD). Vacío = 20 semanas antes del objetivo (antes: base de mantenimiento)
PLAN_START=

# Opcionales: si están vacíos se leen de intervals.icu
LTHR=
MAX_HR=
REST_HR=
CSS_SEC_PER_100M=

# ---- Cuentas (Fase 1)
# Base de datos: vacío = SQLite en backend/data/trainsync.db; producción: postgresql+psycopg://usuario:clave@host/trainsync
DATABASE_URL=
# Secreto de las sesiones (obligatorio al desplegar): python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Cifrado AES-256 de las claves de intervals.icu de cada usuario: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
