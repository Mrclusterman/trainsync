# Copia a .env (nunca lo subas a git).
# La app NO usa estas credenciales: cada usuario vincula su propia cuenta de intervals.icu en la web.
# Solo las lee la validación con datos reales (cd backend && python -m validation.run --real).
INTERVALS_ATHLETE_ID=i000000
INTERVALS_API_KEY=

# Las preferencias de entrenamiento (deportes, días, minutos, fuerza) están en el perfil de cada usuario en la web

# ---- Cuentas (Fase 1)
# Base de datos: vacío = SQLite en backend/data/trainsync.db; producción: postgresql+psycopg://usuario:clave@host/trainsync
DATABASE_URL=
# Secreto de las sesiones (obligatorio al desplegar): python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Cifrado AES-256 de las claves de intervals.icu de cada usuario: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
